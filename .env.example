# SumUp React Native SDK — public key (sup_pk_...)
# Used by SumUpProvider in _layout.tsx
EXPO_PUBLIC_SUMUP_API_KEY=sup_pk_YOUR_PUBLIC_KEY_HERE

# Authenticated OtaMaps backend that creates SumUp checkouts server-side
EXPO_PUBLIC_BACKEND_URL=https://api.example.com

# Supabase project used by authentication, beacons, and location sharing
EXPO_PUBLIC_SUPABASE_URL=https://db.otamaps.fi
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# OtaMaps API hosting GraphQL and the Wilma-to-Supabase auth exchange
EXPO_PUBLIC_OTAMAPS_API_URL=https://api.otamaps.fi

# Public Sentry client DSN and environment label used for mobile error tracking
EXPO_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/0
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Secret build-only token for source-map uploads; configure it in each EAS environment.
SENTRY_AUTH_TOKEN=sntrys_YOUR_AUTH_TOKEN

# Wilma is the primary login. Set to false only for an emergency rollback.
EXPO_PUBLIC_WILMA_PRIMARY_AUTH_ENABLED=true

# MapTiler browser/mobile key. Restrict it in the provider dashboard.
EXPO_PUBLIC_MAPTILER_KEY=YOUR_RESTRICTED_MAPTILER_KEY
