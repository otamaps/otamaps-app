# SumUp React Native SDK — public key (sup_pk_...)
# Used by SumUpProvider in _layout.tsx
EXPO_PUBLIC_SUMUP_API_KEY=sup_pk_YOUR_PUBLIC_KEY_HERE

# SumUp REST API — secret key (sup_sk_...)
# Used by sumupService.ts to create checkouts & customers via api.sumup.com
# Get both keys from: https://me.sumup.com/settings/api-keys
EXPO_PUBLIC_SUMUP_SECRET_KEY=REDACTED_SUMUP_SECRET

# Your SumUp Merchant Code (found in account settings)
EXPO_PUBLIC_SUMUP_MERCHANT_CODE=MXXXXXXX

# Deep-link return URL after payment (must match your app scheme)
EXPO_PUBLIC_PAYMENT_RETURN_URL=otamaps://payment/return
