# Environment Variables Template for SumUp Integration
# Copy this to your .env file and fill in your actual values

# SumUp API Configuration
# Get your API key from: https://me.sumup.com/settings/api-keys
EXPO_PUBLIC_SUMUP_API_KEY=sup_pk_V90pKVYRuqepjCgHYeOzOafFM3oEU0lil
EXPO_PUBLIC_SUMUP_SECRET_KEY=sup_sk_jPH9SlrAYqTY4lytLrLAd29P6Nx7JPkqN

# Your SumUp Merchant Code
# Found in your SumUp account settings
EXPO_PUBLIC_SUMUP_MERCHANT_CODE=M8FP56ZC

# Backend API Configuration (update with your actual backend URL)
# Example: https://api.yourdomain.com
EXPO_PUBLIC_BACKEND_API_URL=https://YOUR_BACKEND_URL/api

# Optional: Payment redirect URLs
# These should match your app's deep linking scheme
EXPO_PUBLIC_PAYMENT_RETURN_URL=otamaps://payment/return
EXPO_PUBLIC_PAYMENT_REDIRECT_URL=otamaps://payment/redirect

EXPO_PUBLIC_DEBUG_BLE=false